<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_LoanApproval" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="LoanApprovalProcess" name="Loan Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LoanReceived" name="Loan application received">
      <bpmn:outgoing>Flow_ToCreditCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToCreditCheck" sourceRef="StartEvent_LoanReceived" targetRef="Task_CreditCheck" />
    <bpmn:serviceTask id="Task_CreditCheck" name="Check credit score">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="credit-check" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreditCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRiskScoring</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRiskScoring" sourceRef="Task_CreditCheck" targetRef="Task_RiskScoring" />
    <bpmn:businessRuleTask id="Task_RiskScoring" name="Evaluate loan risk">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="RiskCategory" resultVariable="riskCategory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRiskScoring</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRiskGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_ToRiskGateway" sourceRef="Task_RiskScoring" targetRef="Gateway_RiskLevel" />
    <bpmn:exclusiveGateway id="Gateway_RiskLevel" name="Risk level?" default="Flow_HighRisk">
      <bpmn:incoming>Flow_ToRiskGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_LowRisk</bpmn:outgoing>
      <bpmn:outgoing>Flow_MediumRisk</bpmn:outgoing>
      <bpmn:outgoing>Flow_HighRisk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_LowRisk" name="LOW" sourceRef="Gateway_RiskLevel" targetRef="Gateway_MergeDisbursement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskCategory = "LOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MediumRisk" name="MEDIUM" sourceRef="Gateway_RiskLevel" targetRef="UserTask_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskCategory = "MEDIUM"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HighRisk" name="HIGH (default)" sourceRef="Gateway_RiskLevel" targetRef="Gateway_MergeRejected" />
    <bpmn:userTask id="UserTask_ManualReview" name="Review loan application">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="LoanReviewForm" />
        <zeebe:assignmentDefinition candidateGroups="loan-officers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MediumRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOfficerGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ToOfficerGateway" sourceRef="UserTask_ManualReview" targetRef="Gateway_OfficerDecision" />
    <bpmn:exclusiveGateway id="Gateway_OfficerDecision" name="Officer decision?" default="Flow_Denied">
      <bpmn:incoming>Flow_ToOfficerGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Denied</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Approved" name="approved" sourceRef="Gateway_OfficerDecision" targetRef="Gateway_MergeDisbursement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Denied" name="denied (default)" sourceRef="Gateway_OfficerDecision" targetRef="Gateway_MergeRejected" />
    <bpmn:exclusiveGateway id="Gateway_MergeDisbursement" name="Merge to disbursement">
      <bpmn:incoming>Flow_LowRisk</bpmn:incoming>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDisbursement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToDisbursement" sourceRef="Gateway_MergeDisbursement" targetRef="Task_PublishDisbursementRequest" />
    <bpmn:exclusiveGateway id="Gateway_MergeRejected" name="Merge to rejected">
      <bpmn:incoming>Flow_HighRisk</bpmn:incoming>
      <bpmn:incoming>Flow_Denied</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToRejected" sourceRef="Gateway_MergeRejected" targetRef="EndEvent_Rejected" />
    <bpmn:serviceTask id="Task_PublishDisbursementRequest" name="Publish disbursement request" zeebe:modelerTemplate="io.camunda.connectors.KAFKA.v1" zeebe:modelerTemplateVersion="6" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:connector-kafka:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="redpanda:9092" target="topic.bootstrapServers" />
          <zeebe:input source="disbursement-requests" target="topic.topicName" />
          <zeebe:input source="noSchema" target="schemaStrategy.type" />
          <zeebe:input source="=customerId" target="message.key" />
          <zeebe:input source="={customerId: customerId, amount: amount}" target="message.value" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="6" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.KAFKA.v1" />
          <zeebe:header key="resultVariable" value="kafkaPublishResult" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDisbursement</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWaitConfirmation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToWaitConfirmation" sourceRef="Task_PublishDisbursementRequest" targetRef="Event_WaitDisbursementConfirmation" />
    <bpmn:sequenceFlow id="Flow_ToDisbursementGateway" sourceRef="Event_WaitDisbursementConfirmation" targetRef="Gateway_DisbursementOutcome" />
    <bpmn:exclusiveGateway id="Gateway_DisbursementOutcome" name="Disbursement succeeded?" default="Flow_DisbursementFailed">
      <bpmn:incoming>Flow_ToDisbursementGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DisbursementSucceeded</bpmn:outgoing>
      <bpmn:outgoing>Flow_DisbursementFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_DisbursementSucceeded" name="succeeded" sourceRef="Gateway_DisbursementOutcome" targetRef="EndEvent_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=disbursementSuccess = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DisbursementFailed" name="failed (default)" sourceRef="Gateway_DisbursementOutcome" targetRef="Task_Compensate" />
    <bpmn:endEvent id="EndEvent_Approved" name="Loan approved">
      <bpmn:incoming>Flow_DisbursementSucceeded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Compensate" name="Notify and compensate customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="compensate-disbursement" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DisbursementFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCompensated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCompensated" sourceRef="Task_Compensate" targetRef="EndEvent_Compensated" />
    <bpmn:endEvent id="EndEvent_Compensated" name="Loan failed - compensated">
      <bpmn:incoming>Flow_ToCompensated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Rejected" name="Loan rejected">
      <bpmn:incoming>Flow_ToRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_WaitDisbursementConfirmation" name="Wait for disbursement confirmation" zeebe:modelerTemplate="io.camunda.connectors.inbound.KafkaIntermediate.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:connector-kafka-inbound:1" />
          <zeebe:property name="authenticationType" value="credentials" />
          <zeebe:property name="topic.bootstrapServers" value="redpanda:9092" />
          <zeebe:property name="topic.topicName" value="disbursement-confirmations" />
          <zeebe:property name="groupId" value="loan-approval-disbursement-confirmations" />
          <zeebe:property name="autoOffsetReset" value="latest" />
          <zeebe:property name="schemaStrategy.type" value="noSchema" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="correlationKeyExpression" value="=value.customerId" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="resultVariable" value="" />
          <zeebe:property name="resultExpression" value="={disbursementSuccess: value.disbursementSuccess, disbursementRef: value.disbursementRef, disbursementFailureReason: value.failureReason}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWaitConfirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDisbursementGateway</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1sfn2c4" messageRef="Message_DisbursementConfirmed" />
    </bpmn:intermediateCatchEvent>
  </bpmn:process>
  <bpmn:message id="Message_DisbursementConfirmed" name="disbursement-confirmed" zeebe:modelerTemplate="io.camunda.connectors.inbound.KafkaIntermediate.v1">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=customerId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="LoanApprovalProcess">
      <bpmndi:BPMNShape id="StartEvent_LoanReceived_di" bpmnElement="StartEvent_LoanReceived">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreditCheck_di" bpmnElement="Task_CreditCheck">
        <dc:Bounds x="240" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RiskScoring_di" bpmnElement="Task_RiskScoring">
        <dc:Bounds x="390" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RiskLevel_di" bpmnElement="Gateway_RiskLevel" isMarkerVisible="true">
        <dc:Bounds x="540" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ManualReview_di" bpmnElement="UserTask_ManualReview">
        <dc:Bounds x="515" y="400" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OfficerDecision_di" bpmnElement="Gateway_OfficerDecision" isMarkerVisible="true">
        <dc:Bounds x="665" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeDisbursement_di" bpmnElement="Gateway_MergeDisbursement" isMarkerVisible="true">
        <dc:Bounds x="665" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeRejected_di" bpmnElement="Gateway_MergeRejected" isMarkerVisible="true">
        <dc:Bounds x="915" y="343" width="50" height="50" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PublishDisbursementRequest_di" bpmnElement="Task_PublishDisbursementRequest">
        <dc:Bounds x="765" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DisbursementOutcome_di" bpmnElement="Gateway_DisbursementOutcome" isMarkerVisible="true">
        <dc:Bounds x="1000" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="980" y="65" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1100" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Compensate_di" bpmnElement="Task_Compensate">
        <dc:Bounds x="1000" y="240" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Compensated_di" bpmnElement="EndEvent_Compensated">
        <dc:Bounds x="1150" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1015" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_034hb29_di" bpmnElement="Event_WaitDisbursementConfirmation">
        <dc:Bounds x="915" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="888" y="138" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToCreditCheck_di" bpmnElement="Flow_ToCreditCheck">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRiskScoring_di" bpmnElement="Flow_ToRiskScoring">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="390" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRiskGateway_di" bpmnElement="Flow_ToRiskGateway">
        <di:waypoint x="490" y="120" />
        <di:waypoint x="540" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LowRisk_di" bpmnElement="Flow_LowRisk">
        <di:waypoint x="590" y="120" />
        <di:waypoint x="665" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MediumRisk_di" bpmnElement="Flow_MediumRisk">
        <di:waypoint x="565" y="145" />
        <di:waypoint x="565" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HighRisk_di" bpmnElement="Flow_HighRisk">
        <di:waypoint x="565" y="145" />
        <di:waypoint x="565" y="368" />
        <di:waypoint x="915" y="368" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToOfficerGateway_di" bpmnElement="Flow_ToOfficerGateway">
        <di:waypoint x="615" y="440" />
        <di:waypoint x="665" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="690" y="415" />
        <di:waypoint x="690" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Denied_di" bpmnElement="Flow_Denied">
        <di:waypoint x="715" y="440" />
        <di:waypoint x="940" y="440" />
        <di:waypoint x="940" y="393" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDisbursement_di" bpmnElement="Flow_ToDisbursement">
        <di:waypoint x="715" y="120" />
        <di:waypoint x="765" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRejected_di" bpmnElement="Flow_ToRejected">
        <di:waypoint x="965" y="368" />
        <di:waypoint x="1015" y="368" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToWaitConfirmation_di" bpmnElement="Flow_ToWaitConfirmation">
        <di:waypoint x="865" y="120" />
        <di:waypoint x="915" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDisbursementGateway_di" bpmnElement="Flow_ToDisbursementGateway">
        <di:waypoint x="951" y="120" />
        <di:waypoint x="1000" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DisbursementSucceeded_di" bpmnElement="Flow_DisbursementSucceeded">
        <di:waypoint x="1050" y="120" />
        <di:waypoint x="1100" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DisbursementFailed_di" bpmnElement="Flow_DisbursementFailed">
        <di:waypoint x="1025" y="145" />
        <di:waypoint x="1025" y="280" />
        <di:waypoint x="1000" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCompensated_di" bpmnElement="Flow_ToCompensated">
        <di:waypoint x="1100" y="280" />
        <di:waypoint x="1150" y="280" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
